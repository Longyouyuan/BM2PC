        <!--Units are in Pa (SI)-->
        <config key="twist" value="0e7"/>
        <config key="bend" value="0e6"/>
        <config key="vmax" value="0.00"/>
      </plugin>
      <joint kind="main" damping=".001"/>
      <geom type="capsule" mass=".0025" size=".005" rgba=".8 .2 .1 1" condim="1"/>
    </composite>
    <body name="slider" pos="0.0 0 1.2">
      <joint name="ctr_x" type="slide" axis="1 0 0" damping="0.0"/>    <!--1.0-->
      <joint name="ctr_y" type="slide" axis="0 1 0" damping="0.0"/>
      <joint name="ctr_z" type="slide" axis="0 0 1" damping="0.0"/>
      <geom size=".02" mass="0.5" rgba="1 0 0 1"/>
      <camera name="follow_slider" mode="track" target="slider" pos="0 -2 0.5" axisangle="1 0 0 60"/>
    </body>
    <site name="moving_goal" type="sphere" size="0.02" rgba="1 1 1 1" pos="0.0 0 1.2"/>
    <site name="tracking_goal" type="sphere" size="0.02" rgba="0 1 0 1" pos="0.0 0 1.2"/>
