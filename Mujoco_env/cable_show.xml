  <statistic center="0 0 0.7" extent="2"/>  <!-- View define -->

  <visual>
    <global elevation="-30"/>
  </visual>

  <compiler autolimits="true"/>

  <size memory="20M"/>

  <worldbody>
    <composite type="cable" curve="s" count="41 1 1" size="1" offset="-1 0 1.2" initial="free">
