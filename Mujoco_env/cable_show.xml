    <!-- cylinder 2 -->
    <body name="cyl_2" pos="0.6 0.4 -1.0">
      <joint name="cyl_2_x" type="slide" axis="1 0 0" damping="100.0"/>    <!--1.0-->
      <joint name="cyl_2_y" type="slide" axis="0 1 0" damping="100.0"/>
      <geom type="cylinder" size="0.05 0.12" rgba="0.48 0.26 0.12 1"/>
<!--      size = [radius, half_height]-->
    </body>

  </worldbody>


